# Database
POSTGRES_USER=openmeet
POSTGRES_PASSWORD=openmeet_password
POSTGRES_DB=openmeet

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+asyncpg://openmeet:openmeet_password@db:5432/openmeet
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (omit PUBLIC_GRAPHQL_URL in production to use same-origin /graphql)
FRONTEND_PORT=5173
PUBLIC_GRAPHQL_URL=http://localhost:8000/graphql

# Consolidated Docker stack (http://localhost:8080 by default)
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
COMPOSE_FRONTEND_URL=http://localhost:8080
COMPOSE_CORS_ORIGINS=http://localhost:8080
COMPOSE_DATABASE_URL=postgresql+asyncpg://openmeet:openmeet_password@db:5432/openmeet

# One-off production administrator bootstrap (prefer command-scoped secrets)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-secret
# ADMIN_FIRST_NAME=Platform
# ADMIN_LAST_NAME=Administrator

# Razorpay (payment provider)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxx

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-production-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (SMTP) - optional, emails are logged to stdout when not set
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_USE_TLS=true
# FROM_EMAIL=noreply@openmeets.com
# FROM_NAME=OpenMeets

# Frontend URLs (used in email links) - defaults shown
# FRONTEND_URL=http://localhost:5173

# SendGrid API - optional, overrides SMTP
# SENDGRID_API_KEY=

# AWS SES - optional, overrides SMTP
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
